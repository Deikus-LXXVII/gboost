		{
			"id": "w66a0k",
			"type": "text",
			"x": 642,
			"y": -800,
			"width": 172,
			"height": 64,
			"text": "[[Installed web app (PWA) on iOS or Android with passkey and Web Push. Served by the primary node; calls the standby when the primary is down (gboost-method.md 6.5-6.6).|Phone approver]]",
			"color": "4"
		},
		{
			"id": "ae35p0",
			"type": "text",
			"x": 642,
			"y": -704,
			"width": 160,
			"height": 64,
			"text": "Desktop",
			"color": "4"
		},
		{
			"id": "92oqnw",
			"type": "text",
			"x": 642,
			"y": -608,
			"width": 160,
			"height": 64,
			"text": "[[State encrypted under a passkey-released key on every node. Any OS (Windows, macOS, Linux) or a VPS. Standby enters limited mode by itself when the primary drops; full takeover after one biometric approval; hands back when the primary returns (gboost-method.md 6.5-6.6).|GBOOST nodes]]",
			"color": "4"
		},
